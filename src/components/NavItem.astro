---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<li>
  {/* biome-ignore lint/a11y/useAnchorContent: https://github.com/biomejs/biome/issues/10663 */}
  <a
    class="block rounded-xs text-lg font-semibold text-sky-700 hover:underline focus-visible:focus-ring"
    href={href}
  >
    <slot />
  </a>
</li>
