---
import { ArrowLeftIcon } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  backLink?: string | undefined;
}

const { title, backLink = "/" } = Astro.props;
---

<Layout title={title}>
  <div class="mx-auto max-w-200">
    <header class="my-8 flex flex-col gap-2">
      <nav>
        <a
          class="flex w-fit items-center gap-1 rounded-xs text-lg font-semibold text-sky-700 outline-sky-600 hover:underline focus-visible:focus-ring"
          href={backLink}
        >
          <ArrowLeftIcon class="size-5" nonScalingStroke />
          <span>Back</span>
        </a>
      </nav>

      <h1 class="font-display text-5xl font-semibold text-mauve-900">
        {title}
      </h1>
    </header>

    <main class="my-8 min-h-80">
      <slot />
    </main>

    <footer class="mt-12 mb-8">
      <p class="font-medium text-mauve-500">Copyright &copy; Hikari Hayashi</p>
    </footer>
  </div>
</Layout>
